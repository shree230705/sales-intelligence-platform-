# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# --- Flask ---
FLASK_ENV=development

# --- MongoDB ---
# Local (non-Docker) development:
MONGO_URI=mongodb://localhost:27017/sales_platform
# When running via `docker compose up`, docker-compose.yml overrides this
# to mongodb://mongodb:27017/sales_platform automatically — you don't need
# to change anything to switch between the two.

# --- JWT ---
# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_long_random_secret

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
